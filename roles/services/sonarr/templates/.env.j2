# roles/services/sonarr/templates/.env.j2
# Sonarr Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# API Configuration
SONARR_API_KEY={{ lookup('community.general.onepassword', 'sonarr', field='api_key', vault=onepassword_vault) }}

# Database Configuration (if using external DB)
{% if use_external_db | default(false) -%}
SONARR_DB_HOST={{ lookup('community.general.onepassword', 'sonarr', field='db_host', vault=onepassword_vault) }}
SONARR_DB_PASS={{ lookup('community.general.onepassword', 'sonarr', field='db_password', vault=onepassword_vault) }}
{% endif -%}

# Additional service-specific variables
SONARR_LOG_LEVEL={{ sonarr_log_level | default('info') }}
