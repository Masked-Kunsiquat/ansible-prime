# roles/services/radarr/templates/.env.j2
# Radarr Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# API Configuration
RADARR_API_KEY={{ lookup('community.general.onepassword', 'radarr', field='api_key', vault=onepassword_vault) }}

# Database Configuration (if using external DB)
{% if use_external_db | default(false) -%}
RADARR_DB_HOST={{ lookup('community.general.onepassword', 'radarr', field='db_host', vault=onepassword_vault) }}
RADARR_DB_PASS={{ lookup('community.general.onepassword', 'radarr', field='db_password', vault=onepassword_vault) }}
{% endif -%}

# Additional service-specific variables
RADARR_LOG_LEVEL={{ radarr_log_level | default('info') }}